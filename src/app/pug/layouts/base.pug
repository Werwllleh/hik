include ../../pug/index
include ../../../components/index
include ../../../blocks/index

block vars
    - var stylesLibs = []
    - var scriptsLibs = []
    - var stylesComponents = []
    - var scriptsComponents = []
    - var stylesBlocks = []
    - var scriptsBlocks = []
    - var stylePage = ''
    - var scriptPage = ''

    - var title = "Document"
    - var description = "Document description"

block use

doctype html
html(lang="ru")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        base(href="./")
        title= title
        meta(name="description" content="" + description)

        // Базовые стили
        link(rel="stylesheet", href="css/app.css")
        // Стили компонентов
        link(rel="stylesheet", href="css/components.css")
        // Стили блоков
        link(rel="stylesheet", href="css/blocks.css")
        // Стили страницы (если есть)
        if stylePage
            link(rel="stylesheet", href=`${stylePage}/${stylePage}.css`)
    body
        +header()
        main.page
            .page__content
                block content
        +footer()


        .styles-libs
            // Стили библиотек
            link(rel="stylesheet", href=`libs/lightgallery/lightgallery-bundle.min.css`)
            link(rel="stylesheet", href=`libs/swiper/swiper-bundle.min.css`)
            each style in stylesLibs
                link(rel="stylesheet", href=`libs/${style}`)

        // Скрипты библиотек
        script(src=`libs/gsap/gsap.min.js`)
        script(src=`libs/gsap/ScrollSmoother.min.js`)
        script(src=`libs/gsap/ScrollTrigger.min.js`)
        script(src=`libs/lightgallery/lightgallery.min.js`)
        script(src=`libs/lightgallery/plugins/lg-zoom.min.js`)
        script(src=`libs/lightgallery/plugins/lg-rotate.min.js`)
        script(src=`libs/lightgallery/plugins/lg-fullscreen.min.js`)
        script(src=`libs/lightgallery/plugins/lg-thumbnail.min.js`)
        script(src=`libs/swiper/swiper-bundle.min.js`)
        each script in scriptsLibs
            script(src=`libs/${script}`)

        // Базовые скрипты
        script(src="js/app.js")
        // Скрипты компонентов
        script(src="js/components.js")
        // Скрипты блоков
        script(src="js/blocks.js")
        // Скрипт страницы (если есть)
        if scriptPage
            script(src=`${scriptPage}/${scriptPage}.js`)

        include ../../../sprite/sprite.svg
