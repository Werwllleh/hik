            .filter
                form(data-filter="checkbox").filter-form
                    .filter-button
                        .filter-button__value
                            .filter-button-default
                                .title
                                    | цвет
                            .filter-button-selected
                                span.filter-button-selected__param цвет:
                                span.filter-button-selected__value
                        .filter-button__right
                            span.filter-button__icon
                                +svg("configurator_arrow")
                            button.filter-button-remove
                                +svg("filter-remove")
                    .filter-data
                        .filter-data__title
                            p цвет:
                            button(type="button").filter-data-close
                                +svg("filter-remove")
                        .filter-data__content
                            .filter-checkbox
                                ul
                                    li
                                        +checkbox("color", "белый", "white")
                                        span.color(style="background: linear-gradient(315deg, #fff 0%, #e5e5e5 100%);border-color:rgba(39, 39, 36, 0.2)")
                                    li
                                        +checkbox("color", "черный", "black")
                                        span.color(style="background: linear-gradient(135deg, #000 0%, #535353 100%);")
                                    li
                                        +checkbox("color", "серый", "gray")
                                        span.color(style="background: linear-gradient(315deg, #dbdbdb 0%, #8e8e8e 100%);")
                                    li
