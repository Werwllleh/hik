                                        span.color(style="background: linear-gradient(315deg, #c05600 0%, #742b00 100%);")
                                    li
                                        +checkbox("color", "оранжевый", "orange")
                                        span.color(style="background: linear-gradient(315deg, #ff9600 0%, #ffc97d 100%);")
