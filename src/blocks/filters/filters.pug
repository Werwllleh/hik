            .filter
                form(data-filter="checkbox").filter-form
                    .filter-button
                        .filter-button__value
                            .filter-button-default
                                .title
                                    | материал
                            .filter-button-selected
                                span.filter-button-selected__param материал:
                                span.filter-button-selected__value
                        .filter-button__right
                            span.filter-button__icon
                                +svg("configurator_arrow")
                            button.filter-button-remove
                                +svg("filter-remove")
                    .filter-data
                        .filter-data__title
                            p материал:
                            button(type="button").filter-data-close
                                +svg("filter-remove")
                        .filter-data__content
