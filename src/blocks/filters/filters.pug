                                ul
                                    li
                                        +checkbox("material", "микрофибра", "microfiber")
                                    li
                                        +checkbox("material", "полиэстер", "polyester")
                                    li
                                        +checkbox("material", "шенилл", "chenille")
                                    li
                                        +checkbox("material", "рогожка", "gunny")
                                    li
