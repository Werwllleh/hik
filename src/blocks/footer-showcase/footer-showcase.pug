mixin footerShowcase()

    //footer-showcase
    .footer-showcase&attributes(attributes)
        .footer-showcase__grid
            .footer-showcase__image.i1
                img(src="", alt="")
            nav.footer-showcase__nav
                ul
                    li
                        a(href="/", data-source="./images/footer-showcase/1.webp, ./images/footer-showcase/1-1.webp", data-position="ltr").footer-showcase__link
                            span.line
                            p кухни
                            span.counter 8
                    li
                        a(href="/", data-source="./images/footer-showcase/2.webp, ./images/footer-showcase/2-1.webp", data-position="center").footer-showcase__link
                            span.line
                            p гардеробные системы
                            span.counter 6
                    li
                        a(href="/", data-source="./images/footer-showcase/3.webp, ./images/footer-showcase/3-1.webp", data-position="rtl").footer-showcase__link
                            span.line
                            p модульные системы
                            span.counter 12
                    li
                        a(href="/", data-source="./images/footer-showcase/4.webp, ./images/footer-showcase/4-1.webp", data-position="ltr").footer-showcase__link
                            span.line
                            p двери
                            span.counter 6
                    li
                        a(href="/", data-source="./images/footer-showcase/5.webp, ./images/footer-showcase/5-1.webp", data-position="center").footer-showcase__link
                            span.line
                            p интерьерная мебель
                            span.counter 35
                    li
                        a(href="/", data-source="./images/footer-showcase/6.webp, ./images/footer-showcase/6-1.webp", data-position="rtl").footer-showcase__link
                            span.line
                            p уличная мебель
                            span.counter 18
            .footer-showcase__image.i2
                img(src="", alt="")
