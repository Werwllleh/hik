mixin footer(template)

    //footer
    footer.footer&attributes(attributes)
        .footer__container
            .footer__body
                if template !== 'customers'
                    .footer__top
                        +footerShowcase()

                .footer__bottom
                    nav.footer__nav
                        span.line.l1
                        a(href="/") главная
                        span.line.l2
                        a(href="/") покупателям
                        span.line.l3
                        a(href="/") дизайнерам
                        span.line.l4
                        a(href="/") шоу-рум
                        span.line.l5
                        a(href="/") контакты
                        span.line.l6
                        span.copyright © 2025 
                            |
                            span HIK
                            span FIL INTERIORS

    .overlay
    .favorite-notify.added
        span.favorite-notify__icon
            +svg("bookmark")
        p.favorite-notify__text Товар добавлен в избранное
        button.favorite-notify__close(type="button", aria-label="Закрыть сообщение", title="Закрыть сообщение")
            +svg("close")
    .favorite-notify.remove
        span.favorite-notify__icon
            +svg("bookmark-remove")
        p.favorite-notify__text Товар удален из избранного
        button.favorite-notify__close(type="button", aria-label="Закрыть сообщение", title="Закрыть сообщение")
            +svg("close")
    .product-preview-modal
        .product-preview-modal__overlay
        .product-preview-modal__container
            button.product-preview-modal__close(type="button", aria-label="Закрыть", title="Закрыть")
                +svg("close")
            .product-preview-modal__swiper.swiper
                .swiper-wrapper
                .product-preview-modal__prev.prev
                    +svg("hero-arrow")
                .product-preview-modal__next.next
                    +svg("hero-arrow")
                .swiper-pagination
    .shoppable-image__poppoer(style="display: none;")
        +hoverSlider(false, false, false, 'tippy')
    +loader()
    +modal('order', 'order')
    +modal('order-success', 'order-success')
    +modal('success', 'success')
