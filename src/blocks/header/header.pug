mixin header(searchType)

    //header
    header.header&attributes(attributes)
        .header__container
            .header__body
                .header__left
                    button(type="button", aria-label="Меню каталога", title="Меню каталога").burger-btn
                        span
                        span
                        span

                    nav.header-nav
                        ul
                            li.header-nav__item
                                a(href="/") каталог
                            li.header-nav__item
                                a(href="/") о бренде
                            li.header-nav__item
                                a(href="/") покупателям
                            li.header-nav__item
                                a(href="/") контакты
                a(href="/").header__logos
                    span.logo-element.logo-secondary
                        +svg("logo2")
                    span.separator
                    span.logo-element.logo-main
                        +svg("logo")
                .header__right
                    button(type="button", aria-label="Поиск", title="Поиск").search-btn.header-icon-btn
                        +svg("search")
                    a(href="/", aria-label="Избранное", title="Избранное").bookmark-btn.header-icon-btn
                        +svg("bookmark")
                    a(href="/", aria-label="Личный кабинет", title="Личный кабинет").user-btn.header-icon-btn
                        +svg("user")
    .header-catalog
        .header-catalog__inner
            .header-catalog__body
                .header-catalog__head
                    .header-catalog__button
                        button(type="button", aria-label="Меню каталога", title="Меню каталога").burger-btn
                            span
                            span
                            span
                        a(href="/") каталог
                .header-catalog__list
                    +catalogCollapse()
                .header-catalog__nav
                    ul
                        li
                            a(href="/") шоу-рум
                        li
                            a(href="/") покупателям
                        li
                            a(href="/") контакты
    .header-search
        .header-search__inner
            .header-search__body
                .header-search__header
                    form(data-form="search", novalidate).header-search__form.form
                        fieldset
                            label.form__field
                                input(data-name="text", name="text", type="text", placeholder="", required).form__input
                                span.form__label Поиск
                            button(type="submit").form__submit
                                +svg("search")
                    button(type="submit").header-search-close
                        +svg("close")
                .header-search__content
                    if searchType !== 2
                        .header-search__message
                            p Введите наименование или артикул товара и&nbsp;мы&nbsp;покажем все, что подходит под ваш запрос
                            p Ничего не найдено
                                br
                                |Попробуйте изменить запрос и мы поищем ещё раз
                    if searchType === 2
                        .header-search-history
                            ul
                                li
                                    .search-history-item
                                        span.search-history-item__icon
                                            +svg("history")
                                        .search-history-item__value(data-search-value="кухонный стол")
                                            | кухонный стол
                                li
                                    .search-history-item
                                        span.search-history-item__icon
                                            +svg("history")
                                        .search-history-item__value(data-search-value="кухонный стол2")
                                            | кухонный стол2
                        .header-search-hints
                            ul
                                li
                                    .header-search-hint
                                        span.header-search-hint__icon
                                            +svg("arrow45")
                                        .header-search-hint__value(data-hint-value="стулья для кухни")
                                            | стулья для кухни
                                li
                                    .header-search-hint
                                        span.header-search-hint__icon
                                            +svg("arrow45")
                                        .header-search-hint__value(data-hint-value="столы для кухни")
                                            | столы для кухни
                                li
                                    .header-search-hint
                                        span.header-search-hint__icon
                                            +svg("arrow45")
                                        .header-search-hint__value(data-hint-value="столик кофейный")
                                            | столик кофейный
                                li
                                    .header-search-hint
                                        span.header-search-hint__icon
                                            +svg("arrow45")
                                        .header-search-hint__value(data-hint-value="стол для улицы")
                                            | стол для улицы
                                li
                                    .header-search-hint
                                        span.header-search-hint__icon
