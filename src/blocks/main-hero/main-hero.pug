mixin mainHero()

    //main-hero
    .main-hero&attributes(attributes)
        .main-hero-swiper
            .swiper
                .swiper-wrapper
                    .swiper-slide
                        .main-hero-slide
                            .main-hero-slide__content
                                .main-hero-inform
                                    h1.main-hero-inform__title Вдохновляющее искусство для жизни
                                    .main-hero-inform__description
                                        .main-hero-inform__about
                                            p.main-hero-inform__category искусство
                                            .main-hero-inform__text
                                                p искусство становится частью вашей жизни: изысканные интерьерные решения, которые наполняют дом уютом, теплом и вдохновением
                                        span.main-hero-inform__index 01
                                    .main-hero-inform__footer
                                        .main-hero-inform__pagination
                                            span
                                            span
                                            span
                                        a(href="/").main-hero-inform__link в каталог
                            .main-hero-slide__image
                                picture
                                    source(srcset="./images/main-hero/1-2x.webp" media="(min-width: 1920px)")
                                    source(srcset="./images/main-hero/1-1600.webp" media="(min-width: 1600px)")
                                    source(srcset="./images/main-hero/1-1280.webp" media="(min-width: 1280px)")
                                    img(src="./images/main-hero/1-1000.webp", alt="")
                    .swiper-slide
                        .main-hero-slide
                            .main-hero-slide__content
                            .main-hero-slide__image
                                picture
                                    source(srcset="./images/main-hero/2-2x.webp" media="(min-width: 1920px)")
                                    source(srcset="./images/main-hero/2-1600.webp" media="(min-width: 1600px)")
                                    source(srcset="./images/main-hero/2-1280.webp" media="(min-width: 1280px)")
                                    img(src="./images/main-hero/2-1000.webp", alt="")


