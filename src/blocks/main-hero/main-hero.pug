mixin mainHero()

    //main-hero
    .main-hero&attributes(attributes)
        .main-hero-swiper
            .swiper.main-hero-swiper__element
                .swiper-wrapper
                    .swiper-slide
                        .main-hero-slide
                            button(type="button", aria-label="Предыдущий слайд", title="Предыдущий слайд").main-hero-slide__prev
                                +svg("hero-arrow")
                            button(type="button", aria-label="Следующий слайд", title="Следующий слайд").main-hero-slide__next
                                +svg("hero-arrow")
                            .main-hero-slide__content
                                .main-hero-inform
                                    .main-hero-inform__top
                                        h1.title Вдохновляющее искусство для жизни
                                        span.index 01
                                    .main-hero-inform__middle
                                        .description
                                            p.category искусство
                                            .text
                                                p искусство становится частью вашей жизни: изысканные интерьерные решения, которые наполняют дом уютом, теплом и&nbsp;вдохновением
                                        span.index 01
                                    .main-hero-inform__bottom
                                        .pagination.hero-swiper-thumbs.swiper
                                            .swiper-wrapper
                                        a(href="/").link в каталог
                            .main-hero-slide__image
                                picture
                                    source(srcset="./images/main-hero/1-2x.webp" media="(min-width: 1920px)")
                                    source(srcset="./images/main-hero/1-1600.webp" media="(min-width: 1600px)")
                                    source(srcset="./images/main-hero/1-1280.webp" media="(min-width: 1280px)")
                                    img(src="./images/main-hero/1-1000.webp", alt="")
                    .swiper-slide
                        .main-hero-slide
                            button(type="button", aria-label="Предыдущий слайд", title="Предыдущий слайд").main-hero-slide__prev
                                +svg("hero-arrow")
                            button(type="button", aria-label="Следующий слайд", title="Следующий слайд").main-hero-slide__next
                                +svg("hero-arrow")
                            .main-hero-slide__content
                                .main-hero-inform
                                    .main-hero-inform__top
                                        h1.title Чувственная эстетика
                                        span.index 02
                                    .main-hero-inform__middle
                                        .description
                                            p.category чувства
                                            .text
                                                p красота становится осязаемой, а&nbsp;пространство дышит гармонией: изысканные детали, игра света и&nbsp;фактур, которые трогают не&nbsp;только взгляд, но&nbsp;и&nbsp;сердце
                                        span.index 02
                                    .main-hero-inform__bottom
                                        .pagination.hero-swiper-thumbs.swiper
                                            .swiper-wrapper
                                        a(href="/").link в каталог
                            .main-hero-slide__image
                                picture
                                    source(srcset="./images/main-hero/2-2x.webp" media="(min-width: 1920px)")
                                    source(srcset="./images/main-hero/2-1600.webp" media="(min-width: 1600px)")
                                    source(srcset="./images/main-hero/2-1280.webp" media="(min-width: 1280px)")
                                    img(src="./images/main-hero/2-1000.webp", alt="")
                    .swiper-slide
                        .main-hero-slide
                            button(type="button", aria-label="Предыдущий слайд", title="Предыдущий слайд").main-hero-slide__prev
                                +svg("hero-arrow")
                            button(type="button", aria-label="Следующий слайд", title="Следующий слайд").main-hero-slide__next
                                +svg("hero-arrow")
                            .main-hero-slide__content
                                .main-hero-inform
                                    .main-hero-inform__top
                                        h1.title природа в&nbsp;равновесии с&nbsp;технологией
                                        span.index 03
                                    .main-hero-inform__middle
                                        .description
                                            p.category баланс
                                            .text
                                                p природные мотивы и&nbsp;высокотехнологичные системы объединяются в&nbsp;едином пространстве, где каждая деталь работает на&nbsp;ваш комфорт
                                        span.index 03
                                    .main-hero-inform__bottom
                                        .pagination.hero-swiper-thumbs.swiper
                                            .swiper-wrapper
                                        a(href="/").link в каталог
                            .main-hero-slide__image
                                picture
                                    source(srcset="./images/main-hero/3-2x.webp" media="(min-width: 1920px)")
                                    source(srcset="./images/main-hero/3-1600.webp" media="(min-width: 1600px)")
                                    source(srcset="./images/main-hero/3-1280.webp" media="(min-width: 1280px)")
                                    img(src="./images/main-hero/3-1000.webp", alt="")
                    .swiper-slide
                        .main-hero-slide.video
                            button(type="button", aria-label="Предыдущий слайд", title="Предыдущий слайд").main-hero-slide__prev
                                +svg("hero-arrow")
                            button(type="button", aria-label="Следующий слайд", title="Следующий слайд").main-hero-slide__next
                                +svg("hero-arrow")
                            .main-hero-slide__content
                                .main-hero-inform
                                    .main-hero-inform__top
                                        h1.title Чувственная эстетика
                                        span.index 04
                                    .main-hero-inform__middle
                                        .description
                                            p.category чувства
                                            .text
                                                p красота становится осязаемой, а&nbsp;пространство дышит гармонией: изысканные детали, игра света и&nbsp;фактур, которые трогают не&nbsp;только взгляд, но&nbsp;и&nbsp;сердце
                                        span.index 04
                                    .main-hero-inform__bottom
                                        .pagination.hero-swiper-thumbs.swiper
                                            .swiper-wrapper
                                        a(href="/").link в каталог
                            .main-hero-slide__video
                                video(autoplay, playsinline, muted, loop, poster="./images/main-hero/v-2x.webp")
                                    source(src="./images/main-hero/video.mp4", type="video/mp4")
                                    source(src="./images/main-hero/video.webm", type="video/webm")
                                    p Ваш браузер не поддерживает встроенные видео.


