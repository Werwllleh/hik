mixin productsSlider(title = '')

    //products-slider
    .products-slider&attributes(attributes)
        .products-slider__header
            button(type="button", aria-label="Предыдущий слайд", title="Предыдущий слайд").products-slider__nav.prev
                +svg("hero-arrow")
            .products-slider__title
                p= title
            button(type="button", aria-label="Следующий слайд", title="Следующий слайд").products-slider__nav.next
                +svg("hero-arrow")
        .products-slider__swiper
            .swiper
                .swiper-wrapper
                    .swiper-slide
                        +hoverSlider(["./images/sofa/1.webp", "./images/sofa/2.webp", "./images/sofa/3.webp",])
                    .swiper-slide
                        +hoverSlider(["./images/sofa/1.webp", "./images/sofa/2.webp", "./images/sofa/3.webp",])
                    .swiper-slide
                        +hoverSlider(["./images/sofa/1.webp", "./images/sofa/2.webp", "./images/sofa/3.webp",])
                    .swiper-slide
                        +hoverSlider(["./images/sofa/1.webp", "./images/sofa/2.webp", "./images/sofa/3.webp",])
                    .swiper-slide
                        +hoverSlider(["./images/sofa/1.webp", "./images/sofa/2.webp", "./images/sofa/3.webp",])
                    .swiper-slide
                        +hoverSlider(["./images/sofa/1.webp", "./images/sofa/2.webp", "./images/sofa/3.webp",])
                    .swiper-slide
                        +hoverSlider(["./images/sofa/1.webp", "./images/sofa/2.webp", "./images/sofa/3.webp",])
                    .swiper-slide
                        +hoverSlider(["./images/sofa/1.webp", "./images/sofa/2.webp", "./images/sofa/3.webp",])
                    .swiper-slide
                        +hoverSlider(["./images/sofa/1.webp", "./images/sofa/2.webp", "./images/sofa/3.webp",])
                    .swiper-slide
                        +hoverSlider(["./images/sofa/1.webp", "./images/sofa/2.webp", "./images/sofa/3.webp",])
                    .swiper-slide
                        +hoverSlider(["./images/sofa/1.webp", "./images/sofa/2.webp", "./images/sofa/3.webp",])

