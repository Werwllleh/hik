mixin hoverSlider(images = [], name = '', price = '', type)

    //hover-slider
    .hover-slider&attributes(attributes)
        .hover-slider__favorite-button
            +favoriteButton()
        a(href="./product_detail.html", data-link="./product_detail.html").hover-slider__link
            .hover-slider__body
                .hover-slider__images
                    .hover-slider__inner
                        if images.length
                          each image in images
                            .hover-slider__column
                                .hover-slider__image
                                    img(src=image, alt="image")
                                .hover-slider__line
                if type !== 'tippy'
                    .hover-slider__swiper
                        .swiper
                            .swiper-wrapper
                                if images.length
                                  each image in images
                                    .swiper-slide
                                        img(src=image, alt="image", data-image)
                .hover-slider__information
                    .hover-slider__name(data-name)
                        p= name ? name : 'ХА648#'
                    .hover-slider__price(data-price)
                        span= price ? price : 'от 566 900₽'
