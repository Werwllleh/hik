mixin hoverSlider(images = [], name = '', price = '')

    //hover-slider
    .hover-slider&attributes(attributes)
        .hover-slider__favorite-button
            +favoriteButton()
        a(href="/").hover-slider__link
            .hover-slider__body
                .hover-slider__images
                    .hover-slider__inner
                        if images.length
                          each image in images
                            .hover-slider__column
                                .hover-slider__image
                                    img(src=image, alt="image")
                                .hover-slider__line
                .hover-slider__swiper
                    .swiper
                        .swiper-wrapper
                            if images.length
                              each image in images
                                .swiper-slide
                                    img(src=image, alt="image")
                .hover-slider__information
                    .hover-slider__name
                        p= name ? name : 'ХА648#'
                    .hover-slider__price
                        span= price ? price : 'от 566 900₽'
