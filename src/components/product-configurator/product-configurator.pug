mixin productConfigurator()

    //product-configurator
    .product-configurator&attributes(attributes)
        .collapse
            .collapse-item
                .collapse-header
                    p.collapse-header__name конфигурации
                    span.collapse-header__line
                    span.collapse-header__icon
                        +svg("configurator_arrow")
                .collapse-wrap
                    .collapse-data
                        .product-configurator-configurations
            .collapse-item
                .collapse-header
                    p.collapse-header__name материалы
                    span.collapse-header__line
                    span.collapse-header__icon
                        +svg("configurator_arrow")
