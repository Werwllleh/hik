mixin shoppableImage(image, hotspots = [])

  //shoppable-image
  .shoppable-image&attributes(attributes)
    img.shoppable-image__src(src=image, alt="Shoppable image")

    if hotspots.length
      each hotspot in hotspots
        button.shoppable-image__hotspot(
          type="button"
          style=`top: ${hotspot.top}%; left: ${hotspot.left}%;`
          data-images=`${hotspot.images.map(i => i)}`
          data-name=hotspot.name
          data-price=hotspot.price
          data-link="./product_detail.html"
        )
          span.shoppable-image__icon
            +svg("plus")
