mixin videoComponent(source = '', poster = '')

    //video-component
    .video-component&attributes(attributes)
        .video-component__wrap
            .video-component__poster
                img(src=poster, alt="Постер к видео")
            video(poster=poster data-src=source, playsinline).video-component__video
                p Ваш браузер не поддерживает встроенные видео.
            button.video-component__button
                p смотреть видео
                span
                    +svg("play")

