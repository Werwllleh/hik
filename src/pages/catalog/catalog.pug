extends ../../app/pug/layouts/base.pug

append vars
  - title = "Каталог"
  - description = ""
  - stylePage = "catalog"
  - scriptPage = "catalog"

append content

    .page-catalog.ppt140
        .page-catalog__container.container
            .page-catalog__list
                +catalogCard('интерьерная мебель', 'гармония инновационных решений и материалов исключительного качества для вашего идеального дома, где каждая деталь отражает ваш статус, а пространство становится произведением дизайнерского искусства', [1,2])
                +catalogCard('кухни', 'гармония инновационных решений и материалов исключительного качества для вашего идеального дома, где каждая деталь отражает ваш статус, а пространство становится произведением дизайнерского искусства', [3]).reverse
                +catalogCard('гардеробные системы', 'Идеальные гардеробные системы, сочетающие инновационные решения и материалы высшего качества, создают пространство, которое подчеркивает ваш статус и превращает каждый уголок в произведение искусства.', [4,5]).hs
                +catalogCard('модульные системы', 'гармония инновационных решений и материалов исключительного качества для вашего идеального дома, где каждая деталь отражает ваш статус, а пространство становится произведением дизайнерского искусства', [6]).reverse
                +catalogCard('двери', 'гармония инновационных решений и материалов исключительного качества для вашего идеального дома, где каждая деталь отражает ваш статус, а пространство становится произведением дизайнерского искусства', [7])
                +catalogCard('уличная мебель', 'гармония инновационных решений и материалов исключительного качества для вашего идеального дома, где каждая деталь отражает ваш статус, а пространство становится произведением дизайнерского искусства', [8]).reverse
            .page-catalog__others.spt
                +productsSlider('новинки каталога')
