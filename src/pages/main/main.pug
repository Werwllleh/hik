                .main-form
                    .main-form__inner
                        h2.main-form__title подпишитесь, чтобы узнавать о&nbsp;новинках раньше всех
                        form(data-form="subscribe", novalidate).main-form__form.form
                            fieldset
                                label.form__field
                                    input(name="email", type="email", inputmode="email", placeholder="", required).form__input
                                    span.form__label ваш e-mail
                                    span.form__error
                                button(type="submit").form__submit подписаться
            section.page-main-video.spt
                .main-video
                    .main-video__inner
                        .main-video__info
                            .main-video__info--inner
                                span.main-video__info--invite посетите наш шоу-рум
                                a(href="https://yandex.ru/maps/-/CPFY7JoG" target="_blank" rel="noreferrer noopener" aria-label="Адрес" title="Адрес шоу-рума").main-video__info--address Москва, ул.&nbsp;Нижняя Сыромятническая,&nbsp;10, стр.&nbsp;7, 3&nbsp;этаж
                                a(href="https://yandex.ru/maps/-/CPFY7JoG" target="_blank" rel="noreferrer noopener" aria-label="Адрес" title="Адрес шоу-рума").main-video__info--detailed
