        .products-listing__pagination.spt.px-wrap
                .pagination
                    .pagination__inner
                        a(href="#").pagination__button.prev.disabled
                            span
                                +svg("hero-arrow")
                            p назад
                        ul.pagination__list
                            li.active
                                a(href="#") 1
                            li
                                a(href="#") 2
                            li
                                a(href="#") 3
                            li
                                a(href="#") 4
                            li
                                span ...
                            li
                                a(href="#") 15
                        a(href="#").pagination__button.next
                            span
                                +svg("hero-arrow")
                            p вперед



